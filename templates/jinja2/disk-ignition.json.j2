{# Ignition disk/filesystem configuration #}
{# Generated from templates/jinja2/disk-ignition.json.j2 #}
{# This provides the storage section for an Ignition config (MicroOS) #}
{
  "storage": {
    "disks": [
{% if storage.disk_layout == "single-root" %}
      {
        "device": "{{ storage.os_disk }}",
        "wipeTable": true,
        "partitions": [
          {
            "label": "efi",
            "sizeMiB": 512,
            "typeGuid": "C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
          },
          {
            "label": "root",
            "sizeMiB": 0
          }
        ]
      }
{% elif storage.disk_layout == "single-disk-multipart" %}
      {
        "device": "{{ storage.os_disk }}",
        "wipeTable": true,
        "partitions": [
          {
            "label": "efi",
            "sizeMiB": 512,
            "typeGuid": "C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
          },
          {
            "label": "root",
            "sizeMiB": {{ storage.os_root_size | replace("G", "") | int * 1024 }}
          },
          {
            "label": "rancher",
            "sizeMiB": {{ storage.rancher_size | replace("G", "") | int * 1024 }}
          }{% if storage.provider != "none" %},
          {
            "label": "storage",
            "sizeMiB": 0
          }
{% endif %}
        ]
      }
{% elif storage.disk_layout == "multi-disk" %}
      {
        "device": "{{ storage.os_disk }}",
        "wipeTable": true,
        "partitions": [
          {
            "label": "efi",
            "sizeMiB": 512,
            "typeGuid": "C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
          },
          {
            "label": "root",
            "sizeMiB": 0
          }
        ]
      },
      {
        "device": "{{ storage.data_disk }}",
        "wipeTable": true,
        "partitions": [
          {
            "label": "rancher",
            "sizeMiB": 0
          }
        ]
      }{% if storage.provider != "none" %},
      {
        "device": "{{ storage.storage_disk }}",
        "wipeTable": true,
        "partitions": [
          {
            "label": "storage",
            "sizeMiB": 0
          }
        ]
      }
{% endif %}
{% endif %}
    ],
    "filesystems": [
      {
        "device": "/dev/disk/by-partlabel/efi",
        "format": "vfat",
        "path": "/boot/efi",
        "wipeFilesystem": true,
        "label": "EFI"
      },
      {
        "device": "/dev/disk/by-partlabel/root",
        "format": "btrfs",
        "path": "/",
        "wipeFilesystem": true,
        "label": "ROOT"
      }{% if storage.disk_layout != "single-root" %},
      {
        "device": "/dev/disk/by-partlabel/rancher",
        "format": "xfs",
        "path": "/var/lib/rancher",
        "wipeFilesystem": true,
        "label": "RANCHER"
      }{% endif %}{% if storage.provider == "longhorn" and storage.disk_layout != "single-root" %},
      {
        "device": "/dev/disk/by-partlabel/storage",
        "format": "xfs",
        "path": "{{ storage.longhorn.data_path }}",
        "wipeFilesystem": true,
        "label": "STORAGE"
      }
{% elif storage.provider == "local-path" and storage.disk_layout != "single-root" %},
      {
        "device": "/dev/disk/by-partlabel/storage",
        "format": "xfs",
        "path": "{{ storage.local_path.data_path }}",
        "wipeFilesystem": true,
        "label": "STORAGE"
      }
{% endif %}
    ]
  }
}
