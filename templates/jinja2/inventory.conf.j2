# K3s Cluster Inventory Configuration
# Generated by K3s Configuration Generator
# Copy this file to the repository root as inventory.conf:
#   cp generated/inventory.conf inventory.conf
#
# Then run the deployment scripts:
#   ./scripts/00-validate-environment.sh
#   ./scripts/01-configure-os.sh
#   ./scripts/02-install-haproxy.sh
#   ./scripts/03-install-k3s-first.sh
#   ./scripts/04-install-k3s-servers.sh
#   ./scripts/05-install-k3s-agents.sh
#   STORAGE_PROVIDER={{ storage.provider }} ./scripts/06-install-storage.sh

# ==============================================================================
# OPERATING SYSTEM CHOICE
# ==============================================================================
OS_DISTRIBUTION="{{ os.distribution }}"

# SLE Micro registration code (required only if OS_DISTRIBUTION="sle-micro")
SLE_REGISTRATION_CODE=""
SLE_REGISTRATION_EMAIL=""

# ==============================================================================
# NETWORK CONFIGURATION
# ==============================================================================
K3S_VIP_IPV4="{{ vip.ipv4 }}"
{% if network.ipv6_enabled %}
K3S_VIP_IPV6="{{ vip.ipv6 }}"
{% else %}
K3S_VIP_IPV6=""
{% endif %}

NETWORK_INTERFACE="{{ network.interface }}"
CLUSTER_DOMAIN="{{ network.domain }}"

# ==============================================================================
# MASTER NODES (Control Plane)
# ==============================================================================
# Format: HOSTNAME IPv4 IPv6 MAC_ADDRESS
MASTER_NODES=(
{% for master in masters %}
{% if network.ipv6_enabled %}
    "{{ master.hostname }} {{ master.ipv4 }} {{ master.ipv6 }} {{ master.mac }}"
{% else %}
    "{{ master.hostname }} {{ master.ipv4 }} - {{ master.mac }}"
{% endif %}
{% endfor %}
)

# ==============================================================================
# WORKER NODES
# ==============================================================================
# Format: HOSTNAME IPv4 IPv6 MAC_ADDRESS
WORKER_NODES=(
{% for worker in workers %}
{% if network.ipv6_enabled %}
    "{{ worker.hostname }} {{ worker.ipv4 }} {{ worker.ipv6 }} {{ worker.mac }}"
{% else %}
    "{{ worker.hostname }} {{ worker.ipv4 }} - {{ worker.mac }}"
{% endif %}
{% endfor %}
)

# ==============================================================================
# K3S CONFIGURATION
# ==============================================================================
K3S_VERSION="{{ k3s.version }}"
K3S_TOKEN="{{ k3s.token }}"
K3S_API_PORT="{{ k3s.api_port }}"
HAPROXY_FRONTEND_PORT="{{ haproxy.frontend_port }}"
HAPROXY_STATS_PORT="{{ haproxy.stats_port }}"
K3S_DISABLE="{{ k3s.disable | join(',') }}"
K3S_CLUSTER_CIDR="{{ k3s.cluster_cidr_v4 }}"
K3S_SERVICE_CIDR="{{ k3s.service_cidr_v4 }}"
{% if network.ipv6_enabled %}
K3S_CLUSTER_CIDR_V6="{{ k3s.cluster_cidr_v6 }}"
K3S_SERVICE_CIDR_V6="{{ k3s.service_cidr_v6 }}"
{% else %}
K3S_CLUSTER_CIDR_V6=""
K3S_SERVICE_CIDR_V6=""
{% endif %}

# ==============================================================================
# SSH CONFIGURATION
# ==============================================================================
SSH_USER="{{ ssh.user }}"
SSH_KEY_PATH="$HOME/.ssh/id_ed25519"
SSH_PORT="{{ ssh.port }}"
{% if ssh.github_users | length > 0 %}
SSH_GITHUB_USERS="{{ ssh.github_users | join(' ') }}"
{% else %}
SSH_GITHUB_USERS=""
{% endif %}
SSH_DISABLE_PASSWORD_AUTH="{{ ssh.disable_password_auth }}"

# ==============================================================================
# HAPROXY / KEEPALIVED
# ==============================================================================
KEEPALIVED_ROUTER_ID="{{ keepalived.router_id }}"
KEEPALIVED_AUTH_PASS="{{ keepalived.auth_pass }}"

# ==============================================================================
# STORAGE
# ==============================================================================
STORAGE_PROVIDER="{{ storage.provider }}"
LONGHORN_DATA_PATH="{{ storage.longhorn.data_path }}"
LONGHORN_VERSION="{{ storage.longhorn.version }}"
LOCAL_PATH_DATA_PATH="{{ storage.local_path.data_path }}"
