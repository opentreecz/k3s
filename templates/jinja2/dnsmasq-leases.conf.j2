{# dnsmasq static leases template #}
{# v2.0.0: Conditional IPv6 sections #}
# dnsmasq Static DHCP Leases for K3s Cluster
# Generated from templates/jinja2/dnsmasq-leases.conf.j2
# Do not edit directly - modify variables.yaml and re-run generate.py

# ==============================================================================
# DHCPv4 Static Leases
# Format: dhcp-host=<MAC>,<IPv4>,<hostname>,<lease-time>
# ==============================================================================

# Master nodes
{% for master in masters %}
dhcp-host={{ master.mac }},{{ master.ipv4 }},{{ master.hostname }},infinite
{% endfor %}

# Worker nodes
{% for worker in workers %}
dhcp-host={{ worker.mac }},{{ worker.ipv4 }},{{ worker.hostname }},infinite
{% endfor %}
{% if network.ipv6_enabled | default(true) and (network.ipv6_mode | default("dhcpv6") == "dhcpv6" or network.ipv6_mode | default("dhcpv6") == "both") %}

# ==============================================================================
# DHCPv6 Static Leases
# Format: dhcp-host=id:<DUID>,[<IPv6>],<hostname>,<lease-time>
# ==============================================================================

# Master nodes
{% for master in masters %}
dhcp-host=id:{{ master.duid }},[{{ master.ipv6 }}],{{ master.hostname }},infinite
{% endfor %}

# Worker nodes
{% for worker in workers %}
dhcp-host=id:{{ worker.duid }},[{{ worker.ipv6 }}],{{ worker.hostname }},infinite
{% endfor %}
{% endif %}

# ==============================================================================
# DNS Records (A)
# ==============================================================================

# VIP (API endpoint)
address=/{{ vip.hostname }}.{{ network.domain }}/{{ vip.ipv4 }}

# Master nodes
{% for master in masters %}
address=/{{ master.hostname }}.{{ network.domain }}/{{ master.ipv4 }}
{% endfor %}

# Worker nodes
{% for worker in workers %}
address=/{{ worker.hostname }}.{{ network.domain }}/{{ worker.ipv4 }}
{% endfor %}
{% if network.ipv6_enabled | default(true) %}

# ==============================================================================
# DNS Records (AAAA)
# ==============================================================================

address=/{{ vip.hostname }}.{{ network.domain }}/{{ vip.ipv6 }}

{% for master in masters %}
address=/{{ master.hostname }}.{{ network.domain }}/{{ master.ipv6 }}
{% endfor %}

{% for worker in workers %}
address=/{{ worker.hostname }}.{{ network.domain }}/{{ worker.ipv6 }}
{% endfor %}
{% endif %}
